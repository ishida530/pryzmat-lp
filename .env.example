# ============================================================
# ASARI CRM — Site API
# https://api.asari.pro/site
# ============================================================

ASARI_USER_ID=
ASARI_TOKEN=

# ============================================================
# Neon (Postgres) — lokalna baza danych ofert (zgodnie z doc ASARI)
# Wartość z: console.neon.tech → projekt → Connect → "Pooled connection"
# Na Vercelu ustawiana automatycznie przez integrację Neon.
# UWAGA: tylko server-side — nigdy z prefiksem NEXT_PUBLIC_
# ============================================================
DATABASE_URL=

# Tylko na czas migracji (scripts/migrate-supabase-to-neon.ts) — potem do usunięcia.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# ============================================================
# Vercel Cron — zabezpieczenie endpointu /api/sync
# Wygeneruj losowy string, np.: openssl rand -hex 32
# Dodaj też do Vercel Environment Variables (Production + Preview)
# ============================================================
CRON_SECRET=

# ============================================================
# SMTP — OVH Shared Hosting (ssl0.ovh.net)
# Skopiuj ten plik do .env.local i uzupełnij wartości.
# ============================================================

# Serwer SMTP
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true

# Dane logowania (pełny adres e-mail jako login — wymagane przez OVH)
SMTP_USER=kontakt@marzdom.pl
SMTP_PASS=

# Nadawca widoczny w e-mailu — musi zgadzać się z SMTP_USER (wymagane przez OVH)
SMTP_FROM=kontakt@marzdom.pl

# Odbiorca zgłoszeń (opcjonalne — domyślnie = COMPANY.email z lib/constants.ts)
SMTP_TO=biuro@marzdom.pl

# ============================================================
# ALTERNATYWY OVH
# ============================================================
# OVH MXplan/WebHosting — port SSL:     SMTP_HOST=ssl0.ovh.net  PORT=465  SECURE=true
# OVH MXplan/WebHosting — STARTTLS:     SMTP_HOST=ssl0.ovh.net  PORT=587  SECURE=false
# OVH Email Pro:                         SMTP_HOST=pro1.mail.ovh.net  PORT=587  SECURE=false
